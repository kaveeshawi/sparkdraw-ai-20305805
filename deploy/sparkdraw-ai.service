[Unit]
Description=Sparkdraw AI (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sparkdraw-ai
Environment=PATH=/var/www/sparkdraw-ai/venv/bin
# Add EnvironmentFile=/var/www/sparkdraw-ai/.env if you store secrets there
ExecStart=/var/www/sparkdraw-ai/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
